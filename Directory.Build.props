<Project>
	<!--
		Realm-owned (2026-08-08), not scattered — the same exception as this realm's own
		Directory.Build.targets (see that file's header): Svartálfheim is a permanent
		architectural leaf, the platform's dependency-graph root, so it declares no
		NorseRef/NorseDesignRef/NorseGeneratorRef and never will. Everything below is
		ordinary project identity and code-quality baseline, exactly as the canonical file
		has it. Doctrine: Glitnir/docs/the-runes.md ch. 2/7.

		The chain import is KEPT (restored 2026-08-20), matching this realm's own
		Directory.Build.targets. It was dropped when this file went realm-owned, on the
		reasoning that a leaf never needs the workspace-vs-standalone NorseRef-crossing
		decision UseProjectReferences carries. That much is true and still true. What it
		missed: Bifröst's root Directory.Build.props carries a SECOND, unrelated payload —
		the NORSE_BUILD_ARTIFACTS_DIR redirect that moves bin/obj off a tree shared with
		another build environment. That one applies to every realm, leaf or not, and the
		import is the only thing carrying it down. Without it this realm's projects wrote
		bin/obj in-tree on the shared ReFS mount no matter which side built, so whichever
		side built last left its own RID and absolute paths baked into
		obj/project.assets.json for the other side to trip over (the "Unable to find
		fallback package folder 'C:\Program Files (x86)\...'" failure, seen from Linux
		reading a Windows-restored tree). The redirect cannot move to Directory.Build.targets
		instead: BaseIntermediateOutputPath must be set before Microsoft.Common.props reads
		it, which is props-time only.

		Inheriting UseProjectReferences and NorseRefVersion along with it is inert here by
		construction — no project in this realm declares a NorseRef for either to govern.
	-->
	<PropertyGroup>
		<!--
			Analyzer tiers follow the platform baseline: Security/Performance/Reliability/Usage
			at latest-All; Design stays at the global baseline because latest-All enables rules
			(e.g. CA1034) that conflict with discriminated-union-style type shapes.
		-->
		<AnalysisLevel>latest-Recommended</AnalysisLevel>
		<AnalysisLevelSecurity>latest-All</AnalysisLevelSecurity>
		<AnalysisLevelPerformance>latest-All</AnalysisLevelPerformance>
		<AnalysisLevelReliability>latest-All</AnalysisLevelReliability>
		<AnalysisLevelUsage>latest-All</AnalysisLevelUsage>
		<!--
			The brand prefix lives here and nowhere else: project folders and .csproj files are
			brand-free, so a fork rebrands by changing "Norse" once per realm — no file renames.
		-->
		<AssemblyName>Norse.$(MSBuildProjectName)</AssemblyName>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>Norse.$(MSBuildProjectName)</RootNamespace>
		<TargetFramework>net11.0</TargetFramework>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningLevel>9999</WarningLevel>
		<_ParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_ParentProps>
	</PropertyGroup>
	<Import Project="$(_ParentProps)" Condition="Exists('$(_ParentProps)')" />
</Project>
