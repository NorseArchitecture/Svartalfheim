<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Authors>Norse Architecture</Authors>
		<Description>Norse.Architecture.Analyzers: the Law of the Realms. NORSE070 wire format never leaves Midgard/Yggdrasil (contract attributes are blessed declarations of intent; anything naming or executing a concrete encoding is not); NORSE071 Midgard is consumed by the world tree alone; NORSE072 realms are bounded contexts whose only doors are published surfaces (.Contracts/.Services/.Components); NORSE073 component RCLs stay platform-free; NORSE079 suppressing any of these is itself a conviction. Jurisdiction derives entirely from assembly names — no configuration exists, and none is honored. Delivered to every realm by the Ginnungagap scatter; packed standalone (analyzers/dotnet/cs) because no-opt-out delivery cannot ride inside a host package — attachment would be contingent on referencing the host, and the law leans on no dependency, not even the forge everyone builds on.</Description>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IsPackable>true</IsPackable>
		<!-- MinVer stamping lives in the scattered src/ props, which this gen/ project never imports —
		     without it here, pack falls to the SDK default 1.0.0 and silently leaves the release train
		     (the 2026-08-03 v1.0.0/v0.0.12 split). Most generators ride shotgun in a host package and
		     never need this; the one gen project that packs standalone carries its own stamping. -->
		<MinVerTagPrefix>v</MinVerTagPrefix>
		<!-- NU5128 fires for any analyzer-only package (no lib/ folder) — IncludeBuildOutput=false means
		     this package never has one, by design. TreatWarningsAsErrors merely escalates the expected
		     warning to a pack-breaking error; suppress it to allow packing as an analyzer-only package. -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
	</PropertyGroup>
	<ItemGroup>
		<None Include="../../LICENSE" Pack="true" PackagePath="\" Condition="Exists('../../LICENSE')" />
		<None Include="bin/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
		<PackageReference Include="MinVer" Version="*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
